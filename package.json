{
  "name": "halluminate-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace @halluminate/web && tsc --noEmit -p tests/e2e/tsconfig.json",
    "build": "npm run typecheck && npm run build --workspace @halluminate/web",
    "test": "npm run test --workspace @halluminate/web",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
